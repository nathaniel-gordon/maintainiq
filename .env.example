# Copy to .env and edit. Nothing in this repository reads a .env file
# automatically; docker compose does, and these are the variables the process
# itself looks at.

# Bearer token required by /api/v1. Unset or empty means the API is open, which
# is fine on a loopback-only bind and not fine anywhere else. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PME_API_TOKEN=

# Log level for every entry point: DEBUG, INFO, WARNING or ERROR.
PME_LOG_LEVEL=INFO
